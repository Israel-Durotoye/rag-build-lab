# Server-only settings. Copy to .env.local (gitignored) and fill in the key.
# Without a key the app still works in source-search mode: it shows the
# matching passages instead of an AI-written answer.
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=deepseek-v4-flash
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_TIMEOUT_MS=50000
# AgentRouter only accepts requests that identify as one of its supported CLI
# clients; override if their policy changes.
# AGENTROUTER_USER_AGENT=claude-cli/2.0.1 (external, cli)
