# Server-only settings for the Python backend. Copy to .env.local (gitignored);
# backend/settings.py loads it at startup and real environment variables win.
# Without a key the app still retrieves passages, but no model writes answers.

# --- Generation: DeepSeek via AgentRouter -----------------------------------
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=deepseek-v4-flash
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_TIMEOUT_MS=60000
# Retries per model for rate limits, timeouts, 5xx and empty replies (0-5).
AGENTROUTER_RETRIES=2
# Optional comma-separated models to try if the main one keeps failing.
AGENTROUTER_FALLBACK_MODELS=
# AgentRouter only accepts requests that identify as one of its supported CLI
# clients; override if their policy changes.
# AGENTROUTER_USER_AGENT=claude-cli/2.0.1 (external, cli)

# --- Retrieval -----------------------------------------------------------------
# Semantic search with FastEmbed. The model (~70 MB) downloads once into
# CAMPUS_DATA_DIR/models. Set CAMPUS_EMBEDDINGS=off for keyword search only.
CAMPUS_EMBEDDINGS=on
CAMPUS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Passages given to the model per question (1-12).
CAMPUS_TOP_K=6

# --- Documents -----------------------------------------------------------------
# OCR for scanned pages and text inside images (RapidOCR). Set to off to disable.
CAMPUS_OCR=on
# Where uploaded documents, indexes and settings are kept (gitignored).
# CAMPUS_DATA_DIR=.state
# Where the embedding model is cached (defaults to CAMPUS_DATA_DIR/models).
# CAMPUS_MODEL_DIR=.state/models
CAMPUS_MAX_DOCUMENTS=12
# Workspaces unused for this many days are deleted at startup.
CAMPUS_WORKSPACE_TTL_DAYS=7

# --- Frontend ------------------------------------------------------------------
# Where Next.js finds the Python backend. Read when running `next build`
# (rewrites are fixed at build time) and by the layout at runtime.
CAMPUS_API_URL=http://127.0.0.1:8000
# Only if the browser calls the backend directly from another origin.
# CAMPUS_CORS_ORIGINS=https://your-frontend.example
