# ============================ The website ====================================
# Server-only settings for the Python backend (backend/). Copy to .env.local
# (gitignored); backend/settings.py loads it at startup and real environment
# variables win. Without a key the site still reads, chunks and searches your
# notes, and explanations are sentences copied from them.

# --- Generation: any OpenAI-compatible chat API --------------------------------
# The AGENTROUTER_* names Campus Guide uses are read as well, after these, so
# the same .env.local serves both sites.
STUDY_MODEL_API_KEY=
STUDY_MODEL=deepseek-v4-flash
STUDY_MODEL_BASE_URL=https://agentrouter.org/v1
STUDY_MODEL_TIMEOUT_MS=60000
# Retries per model for rate limits, timeouts, 5xx and empty replies (0-5).
STUDY_MODEL_RETRIES=2
# Optional comma-separated models to try if the main one keeps failing.
STUDY_MODEL_FALLBACKS=
# AgentRouter only accepts requests that identify as one of its supported CLI
# clients; other providers ignore the header.
# STUDY_MODEL_USER_AGENT=claude-cli/2.0.1 (external, cli)

# --- Retrieval -----------------------------------------------------------------
# Semantic search with FastEmbed. The model (~70 MB) downloads once into
# STUDY_EMBEDDING_DIR. Set STUDY_EMBEDDINGS=off for keyword search only.
STUDY_EMBEDDINGS=on
STUDY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Matches per question, the context word budget, the expansion threshold and
# the fixed chunk size are the student's settings, changed on the Settings page.

# --- Notes ---------------------------------------------------------------------
# OCR for scanned pages and text inside images (RapidOCR). Set to off to disable.
STUDY_OCR=on
# Where uploaded notes, indexes, settings and practice sets are kept (gitignored).
# STUDY_DATA_DIR=.state
# Where the embedding model is cached (defaults to STUDY_DATA_DIR/models).
# STUDY_EMBEDDING_DIR=.state/models
STUDY_MAX_DOCUMENTS=12
# Workspaces unused for this many days are deleted at startup.
STUDY_WORKSPACE_TTL_DAYS=7

# --- Frontend ------------------------------------------------------------------
# Where Next.js finds the Python backend. Read when running `next build`
# (rewrites are fixed at build time) and by the layout at runtime.
STUDY_API_URL=http://127.0.0.1:8001
# Only if the browser calls the backend directly from another origin.
# STUDY_CORS_ORIGINS=https://your-frontend.example

# =================== The command-line and Streamlit demo ======================
# app.py and rag_core.cli run offline in source-search mode with none of these
# set. Export them in your shell; they are not read from .env files.
RAG_GENERATOR=none
# Local generation: RAG_GENERATOR=ollama and the name of a model you have installed.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
# OpenAI-compatible endpoint: RAG_GENERATOR=openai plus these. Never commit a real key.
RAG_OPENAI_BASE_URL=
RAG_OPENAI_MODEL=
RAG_OPENAI_API_KEY=
# Optional semantic retrieval (downloads weights on first use).
RAG_EMBEDDING_MODEL=
RAG_RERANKER_MODEL=
RAG_TIMEOUT=30
