# Study Companion runs offline in source-search mode with no variables set.
# Export these in your shell; .env is not loaded automatically.
RAG_GENERATOR=none
# Local generation: RAG_GENERATOR=ollama and the name of a model you have installed.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
# OpenAI-compatible endpoint: RAG_GENERATOR=openai plus these. Never commit a real key.
RAG_OPENAI_BASE_URL=
RAG_OPENAI_MODEL=
RAG_OPENAI_API_KEY=
# Optional semantic retrieval (downloads weights on first use).
RAG_EMBEDDING_MODEL=
RAG_RERANKER_MODEL=
RAG_TIMEOUT=30
