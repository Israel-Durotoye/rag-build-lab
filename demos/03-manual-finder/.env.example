# ============================ The website ====================================
# Server-only settings for the Python backend (backend/). Copy to .env.local
# (gitignored); backend/settings.py loads it at startup and real environment
# variables win. Without a key the site still searches, filters by model,
# looks up codes and compares search modes, and answers are sentences copied
# from the manuals.

# --- Generation: any OpenAI-compatible chat API --------------------------------
# The AGENTROUTER_* names Campus Guide and Study Companion use are read as
# well, after these, so the same .env.local serves all three sites.
MANUAL_MODEL_API_KEY=
MANUAL_MODEL=deepseek-v4-flash
MANUAL_MODEL_BASE_URL=https://agentrouter.org/v1
MANUAL_MODEL_TIMEOUT_MS=60000
# Retries per model for rate limits, timeouts, 5xx and empty replies (0-5).
MANUAL_MODEL_RETRIES=2
# Optional comma-separated models to try if the main one keeps failing.
MANUAL_MODEL_FALLBACKS=
# AgentRouter only accepts requests that identify as one of its supported CLI
# clients; other providers ignore the header.
# MANUAL_MODEL_USER_AGENT=claude-cli/2.0.1 (external, cli)

# --- Retrieval -----------------------------------------------------------------
# Semantic search with FastEmbed. The model (~70 MB) downloads once into
# MANUAL_EMBEDDING_DIR. Set MANUAL_EMBEDDINGS=off for keyword search only.
MANUAL_EMBEDDINGS=on
MANUAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Matches per question, the RRF constant and the context word budget are each
# workspace's settings, changed on the Settings page.

# --- Manuals -------------------------------------------------------------------
# OCR for scanned pages and text inside images (RapidOCR). Set to off to disable.
MANUAL_OCR=on
# Where manuals, indexes, settings and evaluation runs are kept (gitignored).
# MANUAL_DATA_DIR=.state
# Where the embedding model is cached (defaults to MANUAL_DATA_DIR/models).
# MANUAL_EMBEDDING_DIR=.state/models
MANUAL_MAX_DOCUMENTS=16
# Workspaces unused for this many days are deleted at startup.
MANUAL_WORKSPACE_TTL_DAYS=7

# --- Frontend ------------------------------------------------------------------
# Where Next.js finds the Python backend. Read when running `next build`
# (rewrites are fixed at build time) and by the layout at runtime.
MANUAL_API_URL=http://127.0.0.1:8002
# Only if the browser calls the backend directly from another origin.
# MANUAL_CORS_ORIGINS=https://your-frontend.example

# =================== The command-line and Streamlit demo ======================
# app.py and rag_core.cli run offline in source-search mode with none of these
# set. Export them in your shell; they are not read from .env files.
RAG_GENERATOR=none
# Local generation: RAG_GENERATOR=ollama and the name of a model you have installed.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
# OpenAI-compatible endpoint: RAG_GENERATOR=openai plus these. Never commit a real key.
RAG_OPENAI_BASE_URL=
RAG_OPENAI_MODEL=
RAG_OPENAI_API_KEY=
# Optional semantic retrieval (downloads weights on first use).
RAG_EMBEDDING_MODEL=
RAG_RERANKER_MODEL=
RAG_TIMEOUT=30
